{
  "mode": "block",
  "log_file": "",
  "log_format": "json",
  "log_level": "info",
  "status_addr": "127.0.0.1:9095",
  "status_allow_remote": false,
  "status_auth_token": "",
  "proxy_enabled": false,
  "listen_addr": "127.0.0.1:8080",
  "backend_url": "http://127.0.0.1:8081",
  "max_body_bytes": 8388608,
  "max_header_bytes": 32768,
  "inspect_window_bytes": 262144,
  "max_multipart_parts": 64,
  "max_array_depth": 8,
  "max_filename_len": 200,
  "multipart_chunk_timeout": 900000000,
  "request_read_timeout": 30000000000,
  "max_concurrent_multipart_per_ip": 4,
  "upload_progress_field_name": "PHP_SESSION_UPLOAD_PROGRESS",
  "block_chunked_multipart": true,
  "block_session_fixation": true,
  "strip_upload_progress": true,
  "strip_powered_by": true,
  "inspect_responses": true,
  "scrub_php_version_in_body": true,
  "max_session_id_cookie_len": 64,
  "allowed_upload_paths": [],
  "rate_limit_per_second": 40,
  "rate_limit_burst": 80,
  "ban_threshold_score": 100,
  "ban_duration": 900000000000,
  "max_tracked_ips": 8192,
  "probe_threshold": 3,
  "probe_window": 60000000000,
  "session_guard_enabled": true,
  "session_poll_interval": 250000000,
  "max_session_file_bytes": 4194304,
  "delete_poisoned_sessions": true,
  "proc_watch_enabled": true,
  "proc_poll_interval": 150000000,
  "proc_burst_interval": 10000000,
  "proc_burst_window": 5000000000,
  "kill_suspicious_exec": true,
  "max_worker_rss_mb": 0,
  "log_watch_enabled": true,
  "auto_harden_on_start": false
}
